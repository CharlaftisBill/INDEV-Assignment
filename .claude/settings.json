      "Bash(limactl shell*&*)",
      "Bash(limactl shell*|*)",
      "Bash(limactl shell*$(*)",
      "Bash(limactl shell*`*)",
      "Bash(limactl shell*>*)",
      "Bash(*/etc/kubernetes/pki/*)",
      "Bash(*.secrets/*)"
    ],
    "deny": [
      "Read(./.secrets/**)",
      "Read(./out/**)",
      "Read(./backups/**)",
      "Bash(cat .secrets/*)",
      "Bash(cat out/*)",
      "Bash(cat backups/*)",
      "Bash(*cat *.secrets/*)",
      "Bash(*head *.secrets/*)",
      "Bash(*tail *.secrets/*)",
      "Bash(*less *.secrets/*)",
      "Bash(*more *.secrets/*)",
      "Bash(*base64 *.secrets/*)",
      "Bash(*xxd *.secrets/*)",
      "Bash(*openssl *.secrets/*.key*)",
      "Bash(*cat */etc/kubernetes/*.conf*)",
      "Bash(*cat */etc/kubernetes/pki/*.key*)",
      "Bash(*kubectl*config view*--raw*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force:*)",
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --no-verify:*)",
      "Agent(mastic-reviewer)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-changed.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
