      "Bash(sudo:*)",
      "Bash(*kubectl* get *,*)",
      "Bash(*kubectl* get *ecret*)",
      "Bash(*kubectl* get *ECRET*)",
      "Bash(*kubectl*--raw*)",
      "Bash(git diff*--no-index*)",
      "Bash(*kubectl*--kubeconfig*--kubeconfig*)",
      "Bash(*kubectl*--kubeconfig=*)",
      "Bash(*KUBECONFIG=*)",
      "Bash(*kubectl*--context*)",
      "Bash(*kubectl*--user*)",
      "Bash(*kubectl*--token*)",
