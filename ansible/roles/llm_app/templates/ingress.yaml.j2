# No ingressClassName: Traefik is the default IngressClass.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ llm_app_name }}
  namespace: {{ llm_app_namespace }}
spec:
  tls:
    - {hosts: [{{ llm_hostname }}], secretName: {{ llm_app_tls_secret }}}
  rules:
    - host: {{ llm_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend: {service: {name: {{ llm_app_name }}, port: {name: http}}}
