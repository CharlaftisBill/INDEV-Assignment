# Issued by the internal CA and renewed by cert-manager before expiry; Traefik serves it for {{ llm_hostname }}.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ llm_app_tls_secret }}
  namespace: {{ llm_app_namespace }}
spec:
  secretName: {{ llm_app_tls_secret }}
  dnsNames: [{{ llm_hostname }}]
  issuerRef: {name: {{ pki_cluster_issuer }}, kind: ClusterIssuer}
  duration: {{ pki_cert_duration }}
  renewBefore: {{ pki_cert_renew_before }}
