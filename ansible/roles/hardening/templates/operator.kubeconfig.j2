apiVersion: v1
kind: Config
clusters:
  - name: {{ cluster_name }}
    cluster:
      server: {{ hardening_api_server }}
      certificate-authority-data: {{ hardening_ca_b64 }}
users:
  - name: {{ hardening_operator_user }}
    user:
      client-certificate-data: {{ hardening_cert_b64 }}
      client-key-data: {{ hardening_key_b64 }}
contexts:
  - name: {{ hardening_operator_user }}@{{ cluster_name }}
    context:
      cluster: {{ cluster_name }}
      user: {{ hardening_operator_user }}
current-context: {{ hardening_operator_user }}@{{ cluster_name }}
