# The monitoring namespace is created bare by ingress_traefik (Traefik watches it); labels merge in here.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ monitoring_namespace }}
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ monitoring_node_exporter_namespace }}
  labels:
    # hostNetwork, hostPID and hostPath are rejected by baseline and restricted: platform namespace, exempt (CLAUDE.md).
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/warn: privileged
