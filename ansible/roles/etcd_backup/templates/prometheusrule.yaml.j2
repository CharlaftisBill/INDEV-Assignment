apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ etcd_backup_rule_name }}
  namespace: {{ ns_monitoring }}
spec:
  groups:
    - name: etcd-backup
      rules:
        - alert: EtcdBackupStale
          # The metric comes from the node-exporter textfile collector; absent covers a backup that never ran or a lost textfile.
          expr: |
            absent(etcd_backup_last_success_timestamp_seconds)
              or (time() - max(etcd_backup_last_success_timestamp_seconds) > {{ etcd_backup_stale_after_seconds }})
          for: {{ etcd_backup_alert_for }}
          labels: {severity: warning}
          annotations:
            summary: No verified etcd snapshot reached the host backup directory in the last {{ etcd_backup_stale_after_seconds }} s (journalctl -u {{ etcd_backup_unit }}).
