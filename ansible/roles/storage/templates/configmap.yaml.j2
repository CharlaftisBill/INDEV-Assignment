# Mirrors upstream deploy/local-path-storage.yaml {{ local_path_provisioner_version }}; helper image pinned by digest and hardened.
kind: ConfigMap
apiVersion: v1
metadata:
  name: local-path-config
  namespace: {{ storage_namespace }}
data:
  config.json: |-
    {"nodePathMap": [{"node": "DEFAULT_PATH_FOR_NON_LISTED_NODES", "paths": [{{ storage_data_dir | to_json }}]}]}
  setup: |-
    #!/bin/sh
    set -eu
    mkdir -m 0777 -p "$VOL_DIR"
  teardown: |-
    #!/bin/sh
    set -eu
    rm -rf "$VOL_DIR"
  helperPod.yaml: |-
    apiVersion: v1
    kind: Pod
    metadata:
      name: helper-pod
    spec:
      priorityClassName: system-node-critical
      tolerations:
        - key: node.kubernetes.io/disk-pressure
          operator: Exists
          effect: NoSchedule
      containers:
        - name: helper-pod
          image: docker.io/library/busybox:{{ local_path_helper_version }}@{{ local_path_helper_digest }}
          imagePullPolicy: IfNotPresent
          resources:
            requests:
              cpu: {{ storage_resources.helper.requests.cpu }}
              memory: {{ storage_resources.helper.requests.memory }}
          # Root, but only DAC_OVERRIDE kept (teardown deletes files owned by other UIDs). The provisioner rejects `add`, so drop every other default capability.
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [CHOWN, FSETID, FOWNER, MKNOD, NET_RAW, SETGID, SETUID, SETFCAP, SETPCAP, NET_BIND_SERVICE, SYS_CHROOT, KILL, AUDIT_WRITE]
            seccompProfile:
              type: RuntimeDefault
